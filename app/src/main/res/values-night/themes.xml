<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme; Compose owns almost all real styling via
         ui/theme/Theme.kt (Material 3). This XML theme exists only for the
         window background prior to Compose taking over, and for the splash. -->
    <style name="Theme.WeirdNet" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/brand_black</item>
        <item name="android:navigationBarColor">@color/brand_black</item>
        <item name="android:windowBackground">@color/brand_black</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
    </style>

    <style name="Theme.WeirdNet.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_black</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.WeirdNet</item>
    </style>
</resources>
